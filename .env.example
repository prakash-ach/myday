# Copy to .env.local for local work. .env.local is gitignored and must stay
# that way. In production these are set in the Vercel dashboard, never in
# the repository.

# Supabase — safe to expose, protected by row level security
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_ or they land in the
# browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
